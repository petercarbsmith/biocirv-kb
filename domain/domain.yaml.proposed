# Model-drafted ontology, awaiting your review.
#
# The retrieval: and compression: blocks below were carried over from your
# current domain.yaml untouched. They are tuned numbers an ablation earned,
# not domain semantics, so nothing here proposes changes to them.
#
# The guiding comments from the shipped domain.yaml are not reproduced here.
# Review this file, then move it over domain.yaml, or re-run with --apply.

name: biocirv-kb
description: >
  Agricultural production, biomass valorization, biorefinery processes, and
  low-carbon fuel policy for the North San Joaquin Valley circular bioeconomy.
entity_types:
- name: Agriculture
  description: The practice of farming, including cultivation of the soil for growing crops
    and rearing animals (crop production, livestock).
- name: Economic Contribution
  description: The financial impact of agriculture on the local economy (economic output,
    employment).
- name: Biomass
  description: Organic material used as a fuel or in industrial production (woody biomass,
    grass biomass).
- name: Protocol
  description: A detailed plan of a scientific experiment or procedure (proximate analysis,
    X-ray fluorescence testing).
- name: Process
  description: A series of actions or steps taken in order to achieve a particular end (fermentation,
    hydrolysis).
- name: Equipment
  description: Tools or machinery used in scientific experiments (microbalance, XRF analyzer).
- name: Regulation_Policy
  description: Government rules, tax credit guidelines, standards, and compliance frameworks
    governing fuel pathways and emissions (LCFS Guidance 22-02, 45ZCF-GREET, ASTM E1755-01).
- name: Environmental_Metric
  description: Quantifiable measure of environmental impact or fuel performance (carbon intensity,
    life cycle greenhouse gas emissions, LAER).
relation_types:
- name: CONTRIBUTES_TO
  description: An entity contributes to an economic outcome or process.
- name: SUPPORTED_BY
  description: A process or outcome is supported by a specific entity or factor.
- name: USES
  description: A process or protocol uses specific equipment or materials.
- name: REGULATED_BY
  description: A process, pathway, or protocol is governed or regulated by a policy or standard.
- name: HAS_METRIC
  description: A process, fuel pathway, or material is characterized by a specific environmental
    or physical metric.
- name: DERIVED_FROM
  description: A byproduct or material originates from a primary crop, feedstock, or agricultural
    activity.
query_classes:
- name: economic_impact
  keywords:
  - economic
  - contribution
  - impact
  hyde_instruction: Write a passage detailing the economic impact of agriculture on a specific
    region.
- name: biomass_analysis
  keywords:
  - biomass
  - analysis
  - protocol
  hyde_instruction: Write a passage describing the analysis process of biomass using specific
    protocols.
- name: agricultural_production
  keywords:
  - crop
  - livestock
  - production
  hyde_instruction: Write a passage about the production levels of crops or livestock in a
    specific area.
- name: regulatory_compliance
  keywords:
  - LCFS
  - GREET
  - carbon intensity
  - emissions
  - guidance
  hyde_instruction: Write a regulatory guidance passage detailing compliance steps and emission
    metrics for fuel pathway certification.
retrieval:
  weights:
    vector: 1.5
    keyword: 1.0
    graph: 0.8
    community: 0.6
    hyde: 1.2
  rrf_k: 60
  candidate_limits:
    vector: 20
    keyword: 20
    graph: 20
    community: 5
    hyde: 20
  graph:
    min_confidence: 0.0
    confidence_weighted: false
    include_citations: false
  reranker:
    enabled: false
    adapter: llm
    pool: 20
    timeout_s: 15.0
    model: null
compression:
  enabled: false
  relevance_floor: 0.0
  max_tokens_per_chunk: 160
