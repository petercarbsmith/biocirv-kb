[32.124,"o","\u001b[1;32mDone. Membrane Materials KB is set up. Next:\u001b[0m\r\n"]
[33.724,"o","\r\n"]
[33.944,"o","\u001b[1m  cd membrane-materials-kb\u001b[0m\r\n"]
[34.694,"o","\u001b[1m  make setup                # install, start Postgres, create the tables\u001b[0m\r\n"]
[35.444,"o","\u001b[1m  uv run sci-rag doctor\u001b[0m\r\n"]
[36.194,"o","\u001b[1m  # copy your PDFs, HTML, Markdown, or text files into data/raw/\u001b[0m\r\n"]
[36.944,"o","\u001b[1m  uv run sci-rag build data/raw\u001b[0m\r\n"]
[37.694,"o","\u001b[1m  uv run sci-rag answer \"a question in your field\"\u001b[0m\r\n"]
[38.444,"o","\r\n"]
[38.664,"o","Then let a model draft the rest of your domain files:\r\n"]
[38.914,"o","\r\n"]
[39.134,"o","\u001b[1m  uv run sci-rag draft manifest --folder data/raw\u001b[0m\r\n"]
[39.884,"o","\u001b[1m  uv run sci-rag draft ontology --from-corpus\u001b[0m\r\n"]
[40.634,"o","\u001b[1m  uv run sci-rag draft questions --count 10\u001b[0m\r\n"]
